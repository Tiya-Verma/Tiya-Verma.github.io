---
import Layout from "../layouts/Layout.astro";
import PageTabs from "../components/PageTabs.astro";
import ScrambleText from "../components/ScrambleText.astro";

// Moments board: a small numbered grid of photos with white squares tucked
// into a few corners. To fill a slot, give it a src:
//   { n: 1, photo: "/moments/01.jpg", alt: "..." }
// A slot with photo: "" shows as a placeholder until then.
type Moment = {
  n: number;
  photo?: string;
  alt?: string;
  accent?: "bl" | "br" | "tr"; // small white square tucked into a corner
};

const moments: Moment[] = [
  { n: 1, photo: "/moments/01.jpg", alt: "Tiya in the sun holding a big plush sloth", accent: "bl" },
  { n: 2, photo: "/moments/02.jpg", alt: "Two gelato cups held side by side" },
  { n: 3, accent: "tr" },
  { n: 4, photo: "/moments/03.jpg", alt: "UBC WiCS x Atlassian event from the check-in table" },
  { n: 5 },
  { n: 6, photo: "/moments/04.jpg", alt: "Tiya holding a crème brûlée with a Happy Birthday plate", accent: "br" },
  { n: 7 },
  { n: 8, photo: "/moments/05.jpg", alt: "Tiya and friends with a giant teddy bear in a lecture hall" },
  { n: 9 },
];

---

<Layout title="about — tiya verma">
  <div class="px-6 md:px-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- top bar: page tabs, right-aligned -->
      <div class="flex justify-end">
        <PageTabs />
      </div>

      <!-- intro: centred hero -->
      <header class="flex flex-col items-center text-center pt-16 md:pt-28">
        <h1
          class="max-w-3xl text-[32px] md:text-[48px] leading-[1.16] tracking-[-0.03em] font-semibold"
        >
          <ScrambleText class="block" text="Hi, I’m Tiya!" />
          <ScrambleText
            class="block text-soft"
            text="I turn complex systems into interfaces that feel human."
            delay={200}
          />
        </h1>

        <!-- education -->
        <p
          class="mt-12 md:mt-16 flex items-center gap-3 text-subhead md:text-reading text-body"
        >
          <img
            src="/ubc-logo.jpg"
            alt="UBC crest"
            class="h-7 md:h-9 w-auto shrink-0"
          />
          <span>B.Sc. Computer Science @ UBC</span>
        </p>

        <!-- socials: brand-coloured tiles, 24px glyphs inside 44pt hit targets -->
        <ul class="mt-8 md:mt-10 flex items-center">
          <li>
            <a
              href="https://www.linkedin.com/in/tiyaverma/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <rect width="32" height="32" rx="5" fill="#0A66C2"></rect>
                <path fill="#fff" d="M7.5 12.5h3.6V25H7.5zM9.3 6.8a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2zM13.4 12.5h3.4v1.7h.05c.48-.9 1.65-1.85 3.4-1.85 3.63 0 4.3 2.39 4.3 5.5V25h-3.58v-6.3c0-1.5-.03-3.43-2.09-3.43-2.09 0-2.41 1.63-2.41 3.32V25h-3.57z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Tiya-Verma"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#181717" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="mailto:tiyaverma2004@yahoo.in"
              aria-label="Email"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <defs>
                  <linearGradient id="mail-tile" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#1E9BFF"></stop>
                    <stop offset="1" stop-color="#0A6CFF"></stop>
                  </linearGradient>
                </defs>
                <rect width="32" height="32" rx="7" fill="url(#mail-tile)"></rect>
                <rect x="6.5" y="9.5" width="19" height="13" rx="2" fill="#fff"></rect>
                <path d="m7.5 10.8 8.5 6.2 8.5-6.2" fill="none" stroke="#0A6CFF" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </li>
        </ul>
      </header>

      <!-- bento grid: one card per section -->
      <div class="mx-auto mt-16 md:mt-24 max-w-[880px] grid grid-cols-1 md:grid-cols-10 gap-2.5">
        <!-- moments: small numbered board of photos and white squares (tall, left) -->
        <section
          id="hi"
          class="flex min-h-[480px] items-center justify-center rounded-3xl bg-[#fafafa] p-6 md:col-span-5 md:row-span-2"
        >
          <ol class="grid w-full max-w-[270px] grid-cols-3 gap-x-3 gap-y-3">
            {moments.map((m) => (
              <li>
                <span class="text-[11px] tabular-nums text-[#6e6e73]">({m.n})</span>
                <div
                  class:list={[
                    "relative mt-1 aspect-square",
                    m.photo === "" && "bg-[#e8e8ed]",
                  ]}
                >
                  {m.photo && (
                    <img src={m.photo} alt={m.alt ?? ""} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                  )}
                  {m.accent && (
                    <span
                      class:list={[
                        "absolute h-[34%] w-[34%] bg-white",
                        m.accent === "bl" && "-bottom-[8%] -left-[8%]",
                        m.accent === "br" && "-bottom-[8%] -right-[8%]",
                        m.accent === "tr" && "right-[6%] top-[6%]",
                      ]}
                      aria-hidden="true"
                    ></span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- experience (top right) -->
        <section id="experience" class="rounded-3xl bg-[#f5f5f7] p-6 md:col-span-5">
          <h2 class="text-footnote font-medium text-soft">Work Experience</h2>
          <ul class="mt-3 space-y-3">
            {[
              { role: "Software Developer", org: "UBC Product Management Club" },
              { role: "Fullstack Developer", org: "UBC MINT" },
              { role: "Marketing and Engagement Coordinator", org: "UBC WiCS youCode" },
            ].map((job) => (
              <li>
                <div class="text-callout font-semibold">{job.role}</div>
                <div class="text-footnote text-soft">{job.org}</div>
              </li>
            ))}
          </ul>
        </section>

        <!-- how I think (middle right) -->
        <section class="rounded-3xl bg-[#f5f5f7] p-6 md:col-span-5">
          <h2 class="text-[28px] md:text-[32px] leading-[1.15] tracking-[-0.03em] font-semibold">
            <span class="text-[#1d1d1f]">Software Engineer</span>
            <span class="mt-1 block text-[20px] md:text-[22px] tracking-[-0.02em] text-[#86868b]">with curiosity for design.</span>
          </h2>
        </section>

        <!-- community (bottom left, narrower) -->
        <section id="community" class="rounded-3xl bg-[#f5f5f7] p-6 flex flex-col md:col-span-4">
          <div class="flex flex-1 items-center justify-center gap-6 py-10">
            <img
              src="/pmc_logo.webp"
              alt="UBC PMC logo"
              class="community-logo h-16 w-16 object-contain"
              onerror="this.style.display='none';"
            />
            <img
              src="/logo-mint-brain.png"
              alt="UBC MINT logo"
              class="community-logo h-16 w-16 object-contain"
              onerror="this.style.display='none';"
            />
            <!-- the jpg has white corners baked in, so clip it to its circle -->
            <img
              src="/logo-wics.jpg"
              alt="UBC Women in CS logo"
              class="community-logo h-16 w-16 rounded-full object-cover"
              onerror="this.style.display='none';"
            />
          </div>
          <h2 class="text-title3 font-semibold text-[#86868b]">my communities at UBC</h2>
        </section>

        <!-- currently (bottom right, wider) -->
        <section class="rounded-3xl bg-[#f5f5f7] p-6 flex flex-col md:col-span-6">
          <div class="mt-auto pt-20 md:pt-10">
            <p class="text-title3 font-semibold text-[#86868b]">
              currently…
            </p>
            <!-- phrases share one grid cell and take turns, so the line never shifts -->
            <p
              class="grid text-[28px] md:text-[32px] leading-[1.15] tracking-[-0.03em] font-semibold text-[#1d1d1f]"
              data-cycle
            >
              <span class="sr-only">building new things, thinking about dessert, reading Shadowhunters</span>
              {["building new things 🛠️", "thinking about dessert 🍰", "reading Shadowhunters 📖"].map((name, i) => (
                <span class="cycle-item col-start-1 row-start-1" data-active={i === 0 ? "" : undefined} aria-hidden="true">
                  {name}
                </span>
              ))}
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .community-logo {
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .community-logo:hover {
    transform: scale(1.18);
  }
  @media (prefers-reduced-motion: reduce) {
    .community-logo,
    .community-logo:hover {
      transition: none;
      transform: none;
    }
  }

  .cycle-item {
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 400ms cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 400ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .cycle-item[data-active] {
    opacity: 1;
    transform: none;
  }
  /* the outgoing name lifts away instead of dropping back */
  .cycle-item[data-leaving] {
    transform: translateY(-0.4em);
  }
  @media (prefers-reduced-motion: reduce) {
    .cycle-item,
    .cycle-item[data-leaving] {
      transform: none;
    }
  }
</style>

<script>
  const HOLD = 2400; // ms each name stays up

  document.querySelectorAll<HTMLElement>("[data-cycle]").forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>(".cycle-item")];
    let i = 0;
    setInterval(() => {
      const prev = items[i];
      i = (i + 1) % items.length;
      const next = items[i];
      prev.removeAttribute("data-active");
      prev.dataset.leaving = "";
      // reset the leaving name below the line once it has faded out
      setTimeout(() => prev.removeAttribute("data-leaving"), 400);
      next.dataset.active = "";
    }, HOLD);
  });
</script>
