---
import Layout from "../layouts/Layout.astro";
import PageTabs from "../components/PageTabs.astro";
import ScrambleText from "../components/ScrambleText.astro";

---

<Layout title="about — tiya verma">
  <div class="px-6 md:px-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- top bar: page tabs, right-aligned -->
      <div class="flex justify-end">
        <PageTabs />
      </div>

      <!-- intro: centred hero -->
      <header class="flex flex-col items-center text-center pt-16 md:pt-28">
        <h1
          class="max-w-3xl text-[32px] md:text-[48px] leading-[1.16] tracking-[-0.03em] font-semibold"
        >
          <ScrambleText class="block" text="Hi, I’m Tiya!" />
          <ScrambleText
            class="block text-soft"
            text="I design moments that spark human connection."
            delay={200}
          />
        </h1>

        <!-- education -->
        <p
          class="mt-12 md:mt-16 flex items-center gap-2.5 text-footnote md:text-subhead text-body"
        >
          <img
            src="/ubc-logo.jpg"
            alt="UBC crest"
            class="h-6 md:h-7 w-auto shrink-0"
          />
          <span>B.Sc. Computer Science @ UBC</span>
        </p>

        <!-- socials: brand-coloured tiles, 24px glyphs inside 44pt hit targets -->
        <ul class="mt-8 md:mt-10 flex items-center">
          <li>
            <a
              href="https://www.linkedin.com/in/tiyaverma/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <rect width="32" height="32" rx="5" fill="#0A66C2"></rect>
                <path fill="#fff" d="M7.5 12.5h3.6V25H7.5zM9.3 6.8a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2zM13.4 12.5h3.4v1.7h.05c.48-.9 1.65-1.85 3.4-1.85 3.63 0 4.3 2.39 4.3 5.5V25h-3.58v-6.3c0-1.5-.03-3.43-2.09-3.43-2.09 0-2.41 1.63-2.41 3.32V25h-3.57z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Tiya-Verma"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#181717" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="mailto:tiyaverma2004@yahoo.in"
              aria-label="Email"
              class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200 ease-apple hover:scale-110"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <defs>
                  <linearGradient id="mail-tile" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#1E9BFF"></stop>
                    <stop offset="1" stop-color="#0A6CFF"></stop>
                  </linearGradient>
                </defs>
                <rect width="32" height="32" rx="7" fill="url(#mail-tile)"></rect>
                <rect x="6.5" y="9.5" width="19" height="13" rx="2" fill="#fff"></rect>
                <path d="m7.5 10.8 8.5 6.2 8.5-6.2" fill="none" stroke="#0A6CFF" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </li>
        </ul>
      </header>

      <!-- bento grid: one card per section -->
      <div class="mx-auto mt-16 md:mt-24 max-w-[880px] grid grid-cols-1 md:grid-cols-10 gap-2.5">
        <!-- hi: intro + main photo (tall, left) -->
        <section
          id="hi"
          class="rounded-3xl bg-[#f5f5f7] p-6 flex flex-col md:col-span-5 md:row-span-2"
        >
          <h2 class="text-title1 leading-[1.16] tracking-[-0.02em] font-semibold">
            I love design &amp; technology,
            <span class="text-soft">
              and the small moments where the two quietly come together to make
              something feel human.
            </span>
          </h2>

          <p class="mt-5 flex items-center gap-1.5 text-subhead text-soft">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 22s-7-7.58-7-13a7 7 0 0 1 14 0c0 5.42-7 13-7 13z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
            <span>Vancouver</span>
          </p>

          <div class="mt-8 flex flex-1 items-center justify-center">
            <img
              src="/photo-main.jpg"
              alt="Tiya by the water at night"
              class="block aspect-square w-full max-w-[200px] rounded-2xl object-cover shadow-[0_20px_45px_-18px_rgba(15,23,42,0.35)]"
              onerror="this.style.background='linear-gradient(135deg,#1f2937,#475569)';this.removeAttribute('src');"
            />
          </div>
        </section>

        <!-- experience (top right) -->
        <section id="experience" class="rounded-3xl bg-[#f5f5f7] p-6 md:col-span-5">
          <h2 class="text-footnote font-medium text-soft">Experience</h2>
          <ol class="mt-3 space-y-4">
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-callout font-semibold">
                  Product Frontend Developer <span class="text-soft">@ UBC MINT MOSS</span>
                </h3>
                <span class="shrink-0 text-footnote text-ghost tabular-nums">2025 — now</span>
              </div>
              <p class="mt-0.5 text-footnote text-muted">
                Making brain signal processing feel less like a lab and more like a tool built for people.
              </p>
            </li>
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-callout font-semibold">
                  Marketing Coordinator <span class="text-soft">@ youCode</span>
                </h3>
                <span class="shrink-0 text-footnote text-ghost tabular-nums">2026</span>
              </div>
              <p class="mt-0.5 text-footnote text-muted">
                Led the engagement and storytelling behind one of UBC's most community-driven hackathons.
              </p>
            </li>
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-callout font-semibold">
                  Frontend Web Developer <span class="text-soft">@ Nomadly</span>
                </h3>
                <span class="shrink-0 text-footnote text-ghost tabular-nums">2025</span>
              </div>
              <p class="mt-0.5 text-footnote text-muted">
                Brought wanderlust to the browser, one interactive destination at a time.
              </p>
            </li>
          </ol>
        </section>

        <!-- how I think (middle right) -->
        <section class="rounded-3xl bg-[#f5f5f7] p-6 md:col-span-5">
          <h2 class="text-footnote font-medium text-soft">How I think</h2>
          <p class="mt-2 text-title3 font-semibold">
            I'm drawn to design that highlights human experiences and feels purposeful.
          </p>
          <p class="mt-3 text-subhead text-muted">
            I view myself as a creative thinker. For me, there is joy in the constant
            pursuit of work that aligns who I am with what I create.
          </p>
        </section>

        <!-- community (bottom left, narrower) -->
        <section id="community" class="rounded-3xl bg-[#f5f5f7] p-6 flex flex-col md:col-span-4">
          <div class="flex items-center gap-2">
            <img
              src="/logo-mint.png"
              alt="UBC MINT logo"
              class="h-9 w-9 rounded-lg bg-white object-cover"
              onerror="this.style.display='none';"
            />
            <img
              src="/logo-wics.jpg"
              alt="UBC Women in CS logo"
              class="h-9 w-9 rounded-lg bg-white object-cover"
              onerror="this.style.display='none';"
            />
          </div>
          <h2 class="mt-10 text-footnote font-medium text-soft md:mt-auto md:pt-10">Community</h2>
          <ul class="mt-1.5 space-y-2.5">
            <li>
              <div class="text-callout font-semibold">UBC MINT</div>
              <div class="text-footnote text-soft">SWE Product Front-End Developer</div>
            </li>
            <li>
              <div class="text-callout font-semibold">UBC Women in CS</div>
              <div class="text-footnote text-soft">youCode Marketing and Engagement Coordinator</div>
            </li>
          </ul>
        </section>

        <!-- 3 words + photo strip (bottom right, wider) -->
        <section class="rounded-3xl bg-[#f5f5f7] p-6 flex flex-col md:col-span-6">
          <div class="flex items-center gap-3">
            <img
              src="/food-pic.JPG"
              alt=""
              class="h-16 w-20 rounded-xl object-cover -rotate-[4deg] shadow-[0_14px_30px_-12px_rgba(15,23,42,0.3)]"
              onerror="this.style.background='linear-gradient(135deg,#bae6fd,#a5b4fc)';this.removeAttribute('src');"
            />
            <img
              src="/youcode-pic.png"
              alt=""
              class="h-16 w-20 rounded-xl object-cover rotate-[2deg] brightness-105 contrast-150 saturate-175 shadow-[0_14px_30px_-12px_rgba(15,23,42,0.3)]"
              onerror="this.style.background='linear-gradient(135deg,#fecdd3,#f9a8d4)';this.removeAttribute('src');"
            />
            <img
              src="/bolt-event.png"
              alt=""
              class="h-16 w-20 rounded-xl object-cover rotate-[5deg] brightness-110 contrast-150 saturate-200 shadow-[0_14px_30px_-12px_rgba(15,23,42,0.3)]"
              onerror="this.style.background='linear-gradient(135deg,#c4b5fd,#c084fc)';this.removeAttribute('src');"
            />
          </div>
          <div class="mt-8 md:mt-auto md:pt-10">
            <p class="text-title3 font-semibold text-soft">
              3 words to describe me…
            </p>
            <p class="text-[28px] md:text-[32px] leading-[1.15] tracking-[-0.03em] font-semibold">
              quiet, curious, always cooking
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
