---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

// first overview paragraph sits under the title; any others open the body
const [summary, ...overviewRest] = project.overview;

// size the demo frame to its content so phones aren't lost in a wide band
const isPhone = project.heroVideo && project.heroVideoFormat !== "desktop";
const isDesktop = project.heroVideo && project.heroVideoFormat === "desktop";
const frameWidth = isPhone ? "max-w-3xl" : "max-w-[960px]";
const frameAspect = isPhone
  ? "aspect-[4/3]"
  : isDesktop
    ? "aspect-video"
    : "aspect-[16/9] md:aspect-[16/8]";

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const info = [
  { label: "Role", value: project.role },
  { label: "Team", value: project.team },
  { label: "Timeline", value: project.timeline },
  { label: "Skills", value: project.skills.join(", ") },
];
---

<Layout title={`${project.company} — tiya verma`}>
  <main>
    <!-- back link -->
    <div class="px-6 md:px-12 pt-6 md:pt-8">
      <div class="max-w-6xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-subhead text-soft hover:text-hover transition-colors duration-200 ease-apple"
        >
          <span aria-hidden="true">‹</span> work
        </a>
      </div>
    </div>

    <!-- title block -->
    <section class="px-6 md:px-12 mt-16 md:mt-24">
      <div class="max-w-6xl mx-auto flex flex-col items-center text-center">
        <h1 class="text-large-title md:text-title-xl font-semibold">
          {project.company}
        </h1>
        <p class="mt-4 max-w-xl text-callout md:text-title3 font-medium text-soft">
          {summary}
        </p>
      </div>
    </section>

    <!-- demo media, framed like an apple.com feature card -->
    <section class="px-6 md:px-12 mt-16 md:mt-28">
      <div class={`${frameWidth} mx-auto`}>
        <div
          class={`relative w-full ${frameAspect} rounded-3xl overflow-hidden shadow-[2px_4px_12px_rgba(0,0,0,0.08)]`}
          style={project.heroVideo
            ? "background:#f5f5f7"
            : `background:${project.bg}`}
        >
          {
            project.heroVideo ? (
              project.heroVideoFormat === "desktop" ? (
                <video
                  src={project.heroVideo}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center p-6 md:p-10">
                  <div class="relative h-full aspect-[9/19.5] max-h-full rounded-[3rem] bg-[#0f0f0f] p-[10px] shadow-[0_30px_60px_-25px_rgba(15,23,42,0.55)]">
                    <div class="relative h-full w-full overflow-hidden rounded-[2.5rem] bg-black">
                      <video
                        src={project.heroVideo}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        class="absolute inset-0 h-full w-full object-cover"
                        style="transform: scale(1.08) translateX(-3%);"
                      />
                      <div class="pointer-events-none absolute inset-x-0 top-0 h-[1.7%] bg-white" />
                      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[3%] bg-white" />
                    </div>
                  </div>
                </div>
              )
            ) : (
              <div
                class="absolute inset-0 flex items-center justify-center"
                set:html={project.inner}
              />
            )
          }
        </div>
      </div>
    </section>

    <!-- info column + reading column -->
    <section class="px-6 md:px-12 mt-16 md:mt-24 pb-20 md:pb-28">
      <div class="max-w-[816px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-[256px_minmax(0,1fr)] gap-10 md:gap-6">
          <aside class="md:sticky md:top-12 self-start">
            <dl class="grid grid-cols-2 md:grid-cols-1 gap-x-6 gap-y-6 md:gap-y-8">
              {
                info.map((i) => (
                  <div>
                    <dt class="text-caption font-medium text-soft">{i.label}</dt>
                    <dd class="mt-0.5 text-reading font-semibold text-heading">
                      {i.value}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </aside>

          <article class="max-w-[560px] space-y-10 text-callout text-body">
            {
              overviewRest.length > 0 && (
                <div class="space-y-5">
                  {overviewRest.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              )
            }

            <div>
              <h2 class="section-label">Problem</h2>
              <ol class="numbered">
                {project.problem.map((p) => <li>{p}</li>)}
              </ol>
            </div>

            {
              project.sections?.map((s) => (
                <div>
                  <h2 class="section-label">{capitalize(s.label)}</h2>
                  {s.intro && s.intro.length > 0 && (
                    <div class="space-y-5">
                      {s.intro.map((p) => (
                        <p>{p}</p>
                      ))}
                    </div>
                  )}
                  {s.items && s.items.length > 0 && (
                    <ol class:list={["numbered", s.intro?.length && "mt-6"]}>
                      {s.items.map((item) => (
                        <li>
                          <strong class="block font-semibold text-heading">
                            {item.heading}
                          </strong>
                          <span class="block mt-1">{item.body}</span>
                        </li>
                      ))}
                    </ol>
                  )}
                </div>
              ))
            }

            <div>
              <h2 class="section-label">Reflections</h2>
              <ol class="numbered">
                {
                  project.reflections.map((r) => (
                    <li>
                      <strong class="block font-semibold text-heading">
                        {r.heading}
                      </strong>
                      <span class="block mt-1">{r.body}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
