---
import Layout from "../layouts/Layout.astro";
import PageTabs from "../components/PageTabs.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects } from "../data/projects";

// display order; featured first, nomadly last, any new project before nomadly
const order = [
  "tier-evo",
  "moss",
  "procreate-3d",
  "qbit-go",
  "alice-in-wellnessland",
  "ai-codereviewer",
  "moodprint",
];
const rank = (slug: string) =>
  slug === "nomadly-earth"
    ? Infinity
    : order.includes(slug)
      ? order.indexOf(slug)
      : order.length;
const ordered = [...projects].sort((a, b) => rank(a.slug) - rank(b.slug));

---

<Layout title="tiya verma — product designer">
  <div class="px-6 md:px-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- top bar: page tabs, right-aligned -->
      <div class="flex justify-end">
        <PageTabs />
      </div>

      <!-- intro: centred title -->
      <header class="flex flex-col items-center text-center pt-16 md:pt-28">
        <h1
          class="text-[32px] md:text-[48px] leading-[1.16] tracking-[-0.03em] font-semibold"
        >
          Work
        </h1>
        <p
          class="text-[24px] md:text-[36px] leading-[1.16] tracking-[-0.02em] font-semibold text-soft"
        >
          Projects &amp; experience
        </p>
      </header>

      <!-- 2-col project grid, full content width, tight gutters -->
      <section class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-2 gap-2.5">
        {
          ordered.map((p) => (
            <WorkCard
              company={p.company}
              bg={p.bg}
              inner={p.inner}
              tagline={p.tagline}
              heroVideo={p.heroVideo}
              heroVideoFormat={p.heroVideoFormat}
              href={`/projects/${p.slug}`}
            />
          ))
        }
      </section>
    </div>
  </div>
</Layout>

