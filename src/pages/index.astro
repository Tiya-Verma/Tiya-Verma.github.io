---
import Layout from "../layouts/Layout.astro";
import PageTabs from "../components/PageTabs.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects } from "../data/projects";

---

<Layout title="tiya verma — product designer">
  <div class="px-6 md:px-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- top banner: name, tagline, tabs -->
      <header>
        <h1
          class="text-hero-sm md:text-hero font-semibold"
        >
          tiya verma
        </h1>
        <p
          class="mt-4 text-title3 md:text-title2 font-normal text-soft"
        >
          Creating moments with design that spark human connection.<br />
          Currently studying at <span class="text-body font-medium">ubc</span>
        </p>

        <div class="mt-8">
          <PageTabs />
        </div>
      </header>

      <hr class="mt-6 border-t border-rule" />

      <!-- 2-col project grid -->
      <section class="pt-10 lg:pt-14 pb-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
          {
            projects.map((p) => (
              <WorkCard
                company={p.company}
                year={p.year}
                bg={p.bg}
                inner={p.inner}
                tagline={p.tagline}
                heroVideo={p.heroVideo}
                heroVideoFormat={p.heroVideoFormat}
                href={`/projects/${p.slug}`}
              />
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
