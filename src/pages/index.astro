---
import Layout from "../layouts/Layout.astro";
import PageTabs from "../components/PageTabs.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects } from "../data/projects";

// display order; featured first, nomadly last, any new project before nomadly
const order = [
  "tier-evo",
  "qbit-go",
  "ai-codereviewer",
  "moodprint",
  "moss",
  "procreate-3d",
  "alice-in-wellnessland",
];
const rank = (slug: string) =>
  slug === "nomadly-earth"
    ? Infinity
    : order.includes(slug)
      ? order.indexOf(slug)
      : order.length;
const ordered = [...projects].sort((a, b) => rank(a.slug) - rank(b.slug));

// first four stay visible; the rest open behind "More builds"
const featured = ordered.slice(0, 4);
const more = ordered.slice(4);

---

<Layout title="tiya verma">
  <div class="px-6 md:px-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- top bar: page tabs, right-aligned -->
      <div class="flex justify-end">
        <PageTabs />
      </div>

      <!-- intro: centred title -->
      <header class="flex flex-col items-center text-center pt-16 md:pt-28">
        <h1
          class="text-[32px] md:text-[48px] leading-[1.16] tracking-[-0.03em] font-semibold"
        >
          Work
        </h1>
        <p
          class="text-[24px] md:text-[36px] leading-[1.16] tracking-[-0.02em] font-semibold text-soft"
        >
          Projects &amp; experience
        </p>
      </header>

      <!-- 2-col project grid, full content width, tight gutters -->
      <section class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-2 gap-2.5">
        {
          featured.map((p) => (
            <WorkCard
              company={p.company}
              bg={p.bg}
              inner={p.inner}
              tagline={p.tagline}
              heroVideo={p.cardVideo ?? p.heroVideo}
              heroVideoFormat={p.heroVideoFormat}
              href={`/projects/${p.slug}`}
            />
          ))
        }
      </section>

      {
        more.length > 0 && (
          <>
            <!-- hidden on the wrapper: the grid class would override it on the section -->
            <div id="more-builds" hidden>
              <section class="mt-2.5 grid grid-cols-1 md:grid-cols-2 gap-2.5">
                {more.map((p) => (
                  <WorkCard
                    company={p.company}
                    bg={p.bg}
                    inner={p.inner}
                    tagline={p.tagline}
                    heroVideo={p.cardVideo ?? p.heroVideo}
                    heroVideoFormat={p.heroVideoFormat}
                    href={`/projects/${p.slug}`}
                  />
                ))}
              </section>
            </div>

            <div class="mt-10 md:mt-14 flex justify-center">
              <button
                type="button"
                data-more-toggle
                aria-controls="more-builds"
                aria-expanded="false"
                class="px-5 py-2.5 rounded-full bg-fill text-reading font-medium text-heading transition-colors duration-200 ease-apple hover:bg-black/[0.08]"
              >
                More builds
              </button>
            </div>
          </>
        )
      }
    </div>
  </div>
</Layout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-more-toggle]");
  const more = document.getElementById("more-builds");

  toggle?.addEventListener("click", () => {
    if (!more) return;
    const open = more.hidden;
    more.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Show less" : "More builds";
  });
</script>

