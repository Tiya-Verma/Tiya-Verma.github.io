---
interface Props {
  company: string;
  href?: string;
  bg: string;
  /** optional inner content (logo / artwork) — html string, used until a demo video exists */
  inner?: string;
  /** short description shown under the title */
  tagline?: string;
  /** optional video src — when set, the card plays the demo */
  heroVideo?: string;
  /** layout for the hero video: "phone" wraps in an iPhone frame, "desktop" plays as a landscape window */
  heroVideoFormat?: "phone" | "desktop";
}

const {
  company,
  href = "#",
  bg,
  inner,
  tagline,
  heroVideo,
  heroVideoFormat = "phone",
} = Astro.props;
---

<!-- demo-first card: video centred and bleeding off the bottom edge,
     title + description sit on a soft blur in the bottom-left corner -->
<a
  href={href}
  class="work-card group block overflow-hidden rounded-3xl bg-[#f5f5f7] ring-1 ring-black/[0.03] [transform:translateZ(0)]"
>
  <div class="relative aspect-[3/2] overflow-hidden">
    {
      heroVideo ? (
        heroVideoFormat === "desktop" ? (
          <div class="absolute inset-x-[8%] top-[8%] md:inset-x-[12%] md:top-[8%] transition-transform duration-700 ease-apple group-hover:scale-[1.02]">
            <video
              src={heroVideo}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              class="block aspect-[16/10] w-full rounded-xl object-cover shadow-[0_30px_60px_-24px_rgba(15,23,42,0.35)] ring-1 ring-black/5"
            />
          </div>
        ) : (
          <div class="absolute inset-x-0 top-[8%] -bottom-[30%] flex justify-center transition-transform duration-700 ease-apple group-hover:scale-[1.02]">
            <div class="relative h-full aspect-[9/19.5] rounded-[1.6rem] bg-[#0f0f0f] p-[5px] shadow-[0_30px_60px_-24px_rgba(15,23,42,0.45)]">
              <div class="relative h-full w-full overflow-hidden rounded-[1.35rem] bg-black">
                <video
                  src={heroVideo}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="absolute inset-0 h-full w-full object-cover"
                  style="transform: scale(1.08) translateX(-3%);"
                />
                <div class="pointer-events-none absolute inset-x-0 top-0 h-[1.7%] bg-white" />
              </div>
            </div>
          </div>
        )
      ) : (
        <div class="absolute inset-0" style={`background:${bg}`}>
          {inner && (
            <div
              class="absolute inset-0 flex items-center justify-center transition-transform duration-700 ease-apple group-hover:scale-[1.02]"
              set:html={inner}
            />
          )}
        </div>
      )
    }

    <!-- progressive blur + fade so the copy stays legible over the demo (tablet and up) -->
    <div class="work-card__blur pointer-events-none absolute inset-x-0 bottom-0 hidden h-[50%] md:block"></div>

    <div class="absolute bottom-0 left-0 hidden max-w-[85%] p-5 md:block lg:max-w-[75%] lg:p-7">
      <h2 class="text-callout lg:text-title2 font-semibold">{company}</h2>
      {tagline && <p class="mt-0.5 lg:mt-1.5 text-footnote lg:text-callout text-muted line-clamp-2">{tagline}</p>}
    </div>
  </div>

  <!-- phones: copy sits under the demo instead of over it -->
  <div class="p-5 md:hidden">
    <h2 class="text-title2 font-semibold">{company}</h2>
    {tagline && <p class="mt-1.5 text-subhead text-muted">{tagline}</p>}
  </div>
</a>

<style>
  .work-card__blur {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: linear-gradient(
      to top,
      #f5f5f7 0%,
      rgba(245, 245, 247, 0.85) 35%,
      rgba(245, 245, 247, 0) 100%
    );
    mask-image: linear-gradient(to top, #000 45%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent 100%);
  }
</style>
