---
interface Props {
  company: string;
  year: string;
  href?: string;
  bg: string;
  /** optional inner content (logo / artwork) — html string */
  inner?: string;
  /** optional one-line tagline shown next to the company chip */
  tagline?: string;
  /** optional type/status label (e.g. "Concept", "Live") shown on the right */
  type?: string;
  /** optional video src — when set, the card plays the video */
  heroVideo?: string;
  /** layout for the hero video: "phone" wraps in an iPhone frame, "desktop" plays as a landscape rectangle */
  heroVideoFormat?: "phone" | "desktop";
}

const {
  company,
  year,
  href = "#",
  bg,
  inner,
  tagline,
  type,
  heroVideo,
  heroVideoFormat = "phone",
} = Astro.props;
---

<a
  href={href}
  class="group block relative aspect-[16/9] rounded-md overflow-hidden ring-1 ring-rule/50"
  style={`background:${bg}`}
>
  {
    heroVideo ? (
      heroVideoFormat === "desktop" ? (
        <video
          src={heroVideo}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center p-4 md:p-6">
          <div class="relative h-full aspect-[9/19.5] max-h-full rounded-[1.4rem] bg-[#0f0f0f] p-[5px] shadow-[0_18px_40px_-18px_rgba(15,23,42,0.45)] transition-transform duration-700 ease-out group-hover:scale-[1.03]">
            <div class="relative h-full w-full overflow-hidden rounded-[1.15rem] bg-black">
              <video
                src={heroVideo}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                class="absolute inset-0 h-full w-full object-cover"
                style="transform: scale(1.08) translateX(-3%);"
              />
              <div class="pointer-events-none absolute inset-x-0 top-0 h-[1.7%] bg-white" />
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[3%] bg-white" />
            </div>
          </div>
        </div>
      )
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        {inner && (
          <div
            class="relative w-full h-full flex items-center justify-center transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            set:html={inner}
          />
        )}
      </div>
    )
  }

  <!-- meta chips pinned to bottom inside the card — visible on hover only -->
  <div class="absolute inset-x-3 bottom-3 md:inset-x-4 md:bottom-4 flex items-center justify-between gap-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
    <div class="flex items-center gap-2 min-w-0">
      <span
        class="shrink-0 rounded-md bg-zinc-100 px-2 py-1 text-[14px] font-semibold text-zinc-900"
      >
        {company}
      </span>
      {
        tagline && (
          <span class="truncate rounded-md bg-zinc-100 px-2 py-1 text-[14px] text-zinc-500">
            {tagline}
          </span>
        )
      }
    </div>
    {
      type && (
        <div class="flex items-center gap-2 shrink-0">
          <span class="rounded-md bg-zinc-100 px-2 py-1 text-[14px] text-zinc-500">
            {type}
          </span>
        </div>
      )
    }
  </div>
</a>
